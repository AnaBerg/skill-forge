{
  "name": "skill-forge",
  "module": "src/index.ts",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "packageManager": "bun@1.3.13",
  "engines": {
    "bun": "124.3.0"
  },
  "scripts": {
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier src --write",
    "format:check": "prettier src --check",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "check": "bun format && bun typecheck && bun lint && bun test:coverage"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/bun": "1.3.13",
    "@vitest/coverage-istanbul": "4.1.5",
    "eslint": "10.3.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.8.3",
    "typescript-eslint": "8.59.1",
    "vitest": "4.1.5"
  },
  "peerDependencies": {
    "typescript": "6.0.3"
  }
}
